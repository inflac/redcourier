#!/bin/bash
# RedCourier sends all of its traffic through Tor's SOCKS port
# (127.0.0.1:9050, which Tails provides), with separate circuits per group.
# Started with torsocks it detects that and lets torsocks route the traffic.

HERE="$(dirname "$(readlink -f "$0")")"
exec "$HERE/usr/bin/redcourier" "$@"
